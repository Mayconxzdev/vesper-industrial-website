# Vesper Equipamentos EX — .htaccess
# Servidor Apache (Skymail/cPanel)

# Ativar compressão gzip para performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache de assets estáticos (1 ano para imagens, fontes e CSS/JS buildados)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/pdf "access plus 6 months"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# SPA — Redirecionar tudo para index.html (exceto arquivos/pastas que existem)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirecionar conexões HTTP normais para HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirecionar www.vesper.ind.br para vesper.ind.br (canônico)
  RewriteCond %{HTTP_HOST} ^www\.vesper\.ind\.br$ [NC]
  RewriteRule ^(.*)$ https://vesper.ind.br/$1 [R=301,L]

  # Não redirecionar requisições para arquivos ou pastas reais
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Redirecionar tudo para index.html
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Fallback em caso de 404 não capturado pelo rewrite
ErrorDocument 404 /index.html
FallbackResource /index.html

# Segurança — headers básicos
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
